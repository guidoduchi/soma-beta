    "ReportAttemptV1":{"kind":"object","required":["report_attempt_id","state","scope","snapshot_state"],"fields":{"report_attempt_id":"uuid","state":"queued|staging|sealed|generating|completed|failed|cancelled","scope":"closed report scope","snapshot_state":"none|partial|sealed|completed_evidence","artifact":"verified artifact metadata|null"}},
    "ReportPageV1":{"kind":"object","required":["items","continuation"],"fields":{"items":"bounded array<ReportAttemptV1>","continuation":"CursorV1|null"}},
    "CursorV1":{"kind":"reference","contract":"spec/lld/_packet-contract-v2.json#cursor_contract"}
  }
