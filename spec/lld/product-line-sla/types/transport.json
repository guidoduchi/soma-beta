    "ClassificationMutationResultV1":{"kind":"object","required":["outcome","service_request_id","classification_state"],"fields":{"outcome":"APPLIED|NO_CHANGE","service_request_id":"uuid","classification_state":"classified|unclassified","contract_product_line_id":"uuid|null","policy_revision_id":"uuid|null"}},
