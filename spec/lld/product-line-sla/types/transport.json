    "CohortDetailQueryV1":{"kind":"transport_query","path_fields":["cohort_key:owner-defined opaque key"],"query_fields":{"as_of_utc":"utc_epoch_seconds|null","cursor":"CursorV1|null","limit":"int 1..500 default 100"},"unknown_fields":"reject"},
