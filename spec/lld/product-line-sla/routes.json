{
  "schema":"SOMA-LLD-ROUTES-V1",
  "lld_id":"LLD-06",
  "base":"/api",
  "routes":[
    {"method":"GET","path":"/product-lines","purpose":"paged reusable Product Line list"},
    {"method":"POST","path":"/product-lines","command":"CreateProductLine"},
    {"method":"POST","path":"/product-lines/{id}/edit","command":"UpdateProductLine"},
    {"method":"POST","path":"/product-lines/{id}/lifecycle","command":"SetCatalogLifecycle"},
    {"method":"GET","path":"/contracts","purpose":"paged Contract list/filter by Customer"},
    {"method":"POST","path":"/contracts","command":"CreateContract"},
    {"method":"POST","path":"/contracts/{id}/lifecycle","command":"SetCatalogLifecycle"},
    {"method":"GET","path":"/contract-product-lines","purpose":"paged CPL list with current policy summary"},
    {"method":"POST","path":"/contract-product-lines","command":"CreateContractProductLine"},
    {"method":"POST","path":"/contract-product-lines/{id}/policy","command":"ReviseSlaPolicy"},
    {"method":"POST","path":"/contract-product-lines/{id}/lifecycle","command":"SetCatalogLifecycle"},
    {"method":"GET","path":"/contract-product-lines/{id}/policy-history","purpose":"immutable policy revision/tier history"},
    {"method":"GET","path":"/sla/classification-mappings","purpose":"paged trusted mapping configuration"},
    {"method":"POST","path":"/sla/classification-mappings","command":"CreateClassificationMapping"},
    {"method":"POST","path":"/sla/classification-mappings/{id}/supersede","command":"SupersedeClassificationMapping"},
    {"method":"POST","path":"/service-requests/{sr_id}/classification/preview","command":"PreviewSrClassification"},
    {"method":"POST","path":"/service-requests/{sr_id}/classification","command":"ClassifyServiceRequest"},
    {"method":"POST","path":"/service-requests/{sr_id}/classification/clear","command":"ClearSrClassification"},
    {"method":"GET","path":"/service-requests/{sr_id}/classification-history","purpose":"paged classification history"},
    {"method":"POST","path":"/service-requests/classification/batch-preview","purpose":"batch eligibility/incompatible/stale/unresolved/individual-review preview"},
    {"method":"POST","path":"/service-requests/classification/batch-apply","command":"ApplyBatchClassification"},
    {"method":"GET","path":"/service-requests/{sr_id}/sla","purpose":"individual exact SLA projection at current/explicit as-of"},
    {"method":"GET","path":"/sla/cohorts","purpose":"paged canonical monthly cohort projections"},
    {"method":"GET","path":"/sla/cohorts/{cohort_key}","purpose":"exact cohort/member drilldown"},
    {"method":"GET","path":"/sla/warnings","purpose":"derived unclassified/uncalculable/duration/cohort/suspension warning projection"},
    {"method":"POST","path":"/reports","command":"StartSlaReportGeneration"},
    {"method":"GET","path":"/reports","purpose":"paged report attempt/completed evidence list"},
    {"method":"GET","path":"/reports/{report_attempt_id}","purpose":"attempt/completed snapshot/artifact metadata and section summaries"},
    {"method":"POST","path":"/reports/{report_attempt_id}/cancel","command":"CancelSlaReportAttempt"}
  ],
  "mutation_headers":["Idempotency-Key/command_id","base revision or exact preview/input token where applicable","authenticated session context from LLD-12 rather than actor identity from request body"],
  "rule":"Transport routes never calculate authoritative percentage/duration/cohort results from client data, never accept discarded Product as classification input and never expose a report-cleanup action after export."
}
