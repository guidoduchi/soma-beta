    {"action_type":"sla.policy.revised","action_version":1,"payload_schema":"SlaPolicyAuditV1","payload_version":1,"target_types":["contract_product_line"],"result_ref_types":["sla_policy_revision","sla_policy_tier"],"sensitive_fields":[]},
    {"action_type":"sla.classification_mapping.created_or_superseded","action_version":1,"payload_schema":"ClassificationMappingAuditV1","payload_version":1,"target_types":["classification_mapping"],"result_ref_types":["classification_mapping"],"sensitive_fields":[]},
    {"action_type":"sla.service_request.classification_changed","action_version":1,"payload_schema":"ServiceRequestClassificationAuditV1","payload_version":1,"target_types":["service_request"],"result_ref_types":["sr_classification_event"],"sensitive_fields":[]},
