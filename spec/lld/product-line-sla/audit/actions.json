  "payload_policy":{"rule":"Audit stores bounded catalog/classification identifiers, exact policy/classification/snapshot fingerprints and artifact metadata; it never copies unrelated report-section domain payloads or mutable live projections.","projection_rule":"Pure individual-SLA/cohort/warning/classification preview reads produce no audit event and no persisted lifecycle fact.","authority_rule":"Audit evidence records accepted changes but never becomes a competing Product Line, Customer Contract, SLA policy, SR classification, live SLA projection or completed-report snapshot authority."}
