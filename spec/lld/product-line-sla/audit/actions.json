    "ProductLineAuditV1":{"fields":["product_line_id:uuid","change_kind:CREATE|UPDATE","prior_revision:int|null","resulting_revision:int","name_fingerprint:sha256","reason_category:string|null"],"forbidden":["Customer SLA authority","Contract policy body","source Product text"]},
    "CatalogLifecycleAuditV1":{"fields":["target_type:product_line|contract|contract_product_line","target_id:uuid","prior_state:active|archived","new_state:active|archived","prior_revision:int","resulting_revision:int","dependency_fingerprint:sha256","reason_category:string"],"forbidden":["history deletion","classification rewrite"]},
    "ContractAuditV1":{"fields":["contract_id:uuid","customer_org_id:uuid","resulting_revision:int","contract_reference_fingerprint:sha256","name_fingerprint:sha256"],"forbidden":["Customer master body","global Product Line SLA authority"]},
    "ContractProductLineAuditV1":{"fields":["contract_product_line_id:uuid","contract_id:uuid","product_line_id:uuid","customer_org_id:uuid","resulting_revision:int","initial_policy_revision_id:uuid|null"],"forbidden":["copied Customer body","cross-customer policy authority"]},
    "SlaPolicyAuditV1":{"fields":["contract_product_line_id:uuid","prior_policy_revision_id:uuid|null","new_policy_revision_id:uuid","policy_revision_ordinal:int","resulting_cpl_revision:int","tier_count:int","policy_fingerprint:sha256","reason_category:string"],"forbidden":["binary floating percentages","rewritten prior policy tiers","per-SR copied SLA results"]},
    "ClassificationMappingAuditV1":{"fields":["mapping_id:uuid","customer_org_id:uuid","mapping_key_type:closed enum","normalized_key_fingerprint:sha256","contract_product_line_id:uuid","action:CREATE|SUPERSEDE","resulting_revision:int","reason_category:string|null"],"forbidden":["raw imported source row","silent uniqueness assertion"]},
    "ServiceRequestClassificationAuditV1":{"fields":["service_request_id:uuid","classification_event_id:uuid","event_kind:ASSIGN|RECLASSIFY|CLEAR|INVALIDATE_CUSTOMER","prior_contract_product_line_id:uuid|null","new_contract_product_line_id:uuid|null","policy_revision_id:uuid|null","customer_org_id:uuid|null","input_fingerprint:sha256","origin:manual_review|automatic_mapping|customer_change|clear","reason_category:string|null"],"forbidden":["SR source body","guessed replacement CPL","computed live SLA projection"]},
    "BatchClassificationAuditV1":{"fields":["batch_correlation_id:string","requested_count:int","eligible_count:int","applied_count:int","unchanged_count:int","rejected_count:int","preview_fingerprint:sha256","result_refs:bounded classification-event refs"],"forbidden":["unbounded per-SR payloads","one giant transaction claim"]},
    "ReportAttemptAuditV1":{"fields":["report_attempt_id:uuid","event:START|SEAL|GENERATING|VERIFYING|FAILED|CANCELLED","state_before:closed report state|null","state_after:closed report state","attempt_revision:int","scope_fingerprint:sha256","snapshot_hash:sha256|null","failure_code:string|null"],"forbidden":["full report rows","Communication bodies","Working Notes","operational cleanup authority"]},
    "CompletedReportAuditV1":{"fields":["report_attempt_id:uuid","snapshot_hash:sha256","artifact_filename:string","artifact_sha256:sha256","artifact_size_bytes:int","verified_at_utc:int","completed_at_utc:int","member_count:int","cohort_count:int","section_count:int"],"forbidden":["mutable live domain payload","post-completion cleanup instruction"]}
  },
  "actions":[
    {"action_type":"sla.product_line.created_or_updated","action_version":1,"payload_schema":"ProductLineAuditV1","payload_version":1,"target_types":["product_line"],"result_ref_types":["product_line"],"sensitive_fields":[]},
