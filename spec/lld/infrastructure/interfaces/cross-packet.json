{"schema":"SOMA-LLD-INTERFACE-REGISTRY-V2","lld_id":"LLD-08","consumed":[{"name":"DataInstanceIdentityReader","provider":"LLD-01","methods":["get(snapshot_or_verified_reader)->data_instance_id"],"types":["data_instance_id=lowercase UUIDv4"],"transaction":"read-only; never mutates"},{"name":"DomainIdFactory","provider":"LLD-02","methods":["new_id()->lowercase UUIDv4"],"types":["uuid"],"transaction":"pure allocator; no commit"},{"name":"DispatchLocationService","provider":"LLD-02","methods":["create_dedicated_for_site(uow,command_context,name,precomputed_match_key)->dispatch_location_id"],"types":["command_context=COMMAND_ENVELOPE_V1 trusted context","name=bounded display text","precomputed_match_key=UNICODE_MATCH_V1 output"],"transaction":"caller UnitOfWork; no nested receipt/commit"},{"name":"SettingDefinitionRegistry","provider":"LLD-02","methods":["get(key)->SettingDefinition|None"],"types":["key=infrastructure.import_directory"],"transaction":"read-only code registry"},{"name":"SettingStore","provider":"LLD-02","methods":["get(snapshot,key)->PersistedSetting|None"],"types":["INFRA_IMPORT_DIRECTORY_SETTING_V1"],"transaction":"read-only for LLD-08; LLD-02 owns writes"},{"name":"DeviceReferenceOperationalReader","provider":"LLD-03","methods":["get(snapshot_or_uow,device_reference_id)->DeviceReferenceOperationalView|None"],"types":["device_reference_id=uuid","DeviceReferenceOperationalView={id,revision,name,lifecycle_context}"],"transaction":"read-only; current-UoW read required for regularization commit"},{"name":"TicketSiteDependencyValidator","provider":"LLD-03","methods":["guard_archive(uow,site_id)->CLEAR|BLOCKED|INDETERMINATE","count_blockers(snapshot,site_id)->int","list_blockers(snapshot,site_id,cursor,limit)->page"],"types":["site_id=uuid","page<=500"],"transaction":"read-only participant; fail-closed"},{"name":"TaskSiteDependencyValidator","provider":"LLD-05","methods":["guard_archive(uow,site_id)->CLEAR|BLOCKED|INDETERMINATE","count_blockers(snapshot,site_