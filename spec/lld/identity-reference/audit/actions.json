  "payload_policy": {
    "rule": "Audit payloads store bounded accepted identifiers, revisions, reason categories, review fingerprints and changed-field classifications. Result rows/lifecycle events remain the source for accepted descriptive/external-identifier values, avoiding unnecessary duplication in audit JSON.",
