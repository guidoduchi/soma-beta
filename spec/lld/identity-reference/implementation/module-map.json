{
  "schema": "SOMA-LLD-IMPLEMENTATION-MAP-V2",
  "lld_id": "LLD-02",
  "root": "src/soma/reference",
  "modules": {
    "domain": "domain/{account_code_review,dependencies,matching,settings,validation}.py",
    "application": "application/{customer_service,contact_service,dispatch_service,lifecycle_service,settings_service,profile_service}.py",
    "queries": "queries/{references,matching,history,channels,_cursor}.py",
    "audit": "audit_registry.py",
    "assets": "assets/unicode_match_v1.json",
    "transport": "api/routes_reference.py",
    "types": "results.py"
  },
  "commands": {
    "CreateCustomerOrganization": "application/customer_service.py",
    "SetCustomerAccountCode": "application/customer_service.py",
    "ConfirmCustomerAccountCodeSharedClaim": "application/customer_service.py",
    "ReassignCustomerAccountCode": "application/customer_service.py",
    "UpdateReferenceDescriptiveData": "application/{customer_service,dispatch_service}.py",
    "CreateContact": "application/contact_service.py",
    "UpdateContactDescriptiveData": "application/contact_service.py",
    "AddContactChannel": "application/contact_service.py",
    "UpdateContactChannel": "application/contact_service.py",
    "ArchiveContactChannel": "application/contact_service.py",
    "ChangeContactAffiliation": "application/contact_service.py",
    "CreateStandaloneDispatchLocation": "application/dispatch_service.py",
    "CreateDedicatedDispatchLocationForSite": "application/dispatch_service.py",
    "ArchiveReference": "application/lifecycle_service.py",
    "ReactivateReference": "application/lifecycle_service.py",
    "WriteSetting": "application/settings_service.py",
    "CreateLocalUserProfileIdentity": "application/profile_service.py",
    "UpdateLocalUserProfileDisplayName": "application/profile_service.py"
  },
  "queries": {
    "GetReferenceById": "queries/references.py",
    "ListActiveReferences": "queries/references.py",
    "MatchCustomerOrganization": "queries/matching.py",
    "PreviewCustomerAccountCodeConflict": "application/customer_service.py",
    "GetCustomerAccountCodeHistory": "queries/history.py",
    "GetContactChannels": "queries/history.py",
    "ValidateContactChannelForUse": "queries/channels.py",
    "MatchContact": "queries/matching.py",
    "GetContactAffiliationHistory": "queries/history.py",
    "PreviewReferenceArchive": "application/lifecycle_service.py",
    "GetSetting": "application/settings_service.py",
    "ListSettingsForOwner": "application/settings_service.py"
  },
  "services": {
    "CustomerReferenceService": "application/customer_service.py",
    "ContactReferenceService": "application/contact_service.py",
    "DispatchLocationService": "application/dispatch_service.py",
    "ReferenceLifecycleService": "application/lifecycle_service.py",
    "SettingService": "application/settings_service.py",
    "LocalUserProfileService": "application/profile_service.py",
    "ReferenceMatcher": "queries/matching.py",
    "ReferenceDependencyRegistry": "domain/dependencies.py",
    "SettingDefinitionRegistry": "domain/settings.py"
  },
  "dependency_direction": [
    "transport -> typed services/queries only",
    "services -> repositories + LLD-01 UoW/audit + declared cross-packet interfaces",
    "repositories -> LLD-01 verified connection/UoW only",
    "matching/normalization is pure and never mutates",
    "LLD-02 never imports LLD-08 private Site tables; current site-derived address uses SiteDispatchAddressProvider"
  ],
  "forbidden": [
    "name/email/address as primary identity",
    "direct writes to LLD-08 Site relations",
    "credential/password/session material in LLD-02",
    "username/login-name field or login authority in Local User Profile",
    "generic setting keys becoming untyped storage",
    "business SQL identifiers derived from route/cursor input"
  ]
}
