{
  "schema":"SOMA-LLD-ROUTES-V1",
  "lld_id":"LLD-02",
  "prefix":"/api/v1",
  "routes":[
    {"method":"GET","path":"/api/v1/reference/customer-organizations","handler":"ListActiveReferences(customer_organization)","auth":"authenticated local application session","success":200},
    {"method":"POST","path":"/api/v1/reference/customer-organizations","handler":"CreateCustomerOrganization","auth":"authenticated local application session + anti-forgery","success":201},
    {"method":"GET","path":"/api/v1/reference/customer-organizations/{customer_org_id}","handler":"GetReferenceById","auth":"authenticated local application session","success":200},
    {"method":"PATCH","path":"/api/v1/reference/customer-organizations/{customer_org_id}","handler":"UpdateReferenceDescriptiveData","auth":"authenticated local application session + anti-forgery","success":200},
    {"method":"PUT","path":"/api/v1/reference/customer-organizations/{customer_org_id}/customer-account-code","handler":"SetCustomerAccountCode","auth":"authenticated local application session + anti-forgery","success":200},
    {"method":"POST","path":"/api/v1/reference/customer-organizations/{customer_org_id}/customer-account-code/confirm-shared-claim","handler":"ConfirmCustomerAccountCodeSharedClaim","auth":"authenticated local application session + anti-forgery + reviewed conflict context","success":200},
    {"method":"GET","path":"/api/v1/reference/customer-organizations/{customer_org_id}/customer-account-code/history","handler":"GetCustomerAccountCodeHistory","auth":"authenticated local application session","success":200},
    {"method":"POST","path":"/api/v1/reference/customer-account-code/reassign","handler":"ReassignCustomerAccountCode","auth":"authenticated local application session + anti-forgery + reviewed conflict context","success":200},

    {"method":"GET","path":"/api/v1/reference/contacts","handler":"ListActiveReferences(contact)","auth":"authenticated local application session","success":200},
    {"method":"POST","path":"/api/v1/reference/contacts","handler":"CreateContact","auth":"authenticated local application session + anti-forgery","success":201},
    {"method":"GET","path":"/api/v1/reference/contacts/{contact_id}","handler":"GetReferenceById","auth":"authenticated local application session","success":200},
    {"method":"PATCH","path":"/api/v1/reference/contacts/{contact_id}","handler":"UpdateContactDescriptiveData","auth":"authenticated local application session + anti-forgery","success":200},
    {"method":"GET","path":"/api/v1/reference/contacts/{contact_id}/channels","handler":"GetContactChannels","auth":"authenticated local application session","success":200},
    {"method":"POST","path":"/api/v1/reference/contacts/{contact_id}/channels","handler":"AddContactChannel","auth":"authenticated local application session + anti-forgery","success":201},
    {"method":"PATCH","path":"/api/v1/reference/contacts/{contact_id}/channels/{contact_channel_id}","handler":"UpdateContactChannel","auth":"authenticated local application session + anti-forgery","success":200},
    {"method":"POST","path":"/api/v1/reference/contacts/{contact_id}/channels/{contact_channel_id}/archive","handler":"ArchiveContactChannel","auth":"authenticated local application session + anti-forgery","success":200},
    {"method":"POST","path":"/api/v1/reference/contacts/{contact_id}/channels/validate-for-use","handler":"ValidateContactChannelForUse","auth":"authenticated local application session","success":200},
    {"method":"POST","path":"/api/v1/reference/contacts/{contact_id}/affiliation","handler":"ChangeContactAffiliation","auth":"authenticated local application session + anti-forgery","success":200},
    {"method":"GET","path":"/api/v1/reference/contacts/{contact_id}/affiliation-history","handler":"GetContactAffiliationHistory","auth":"authenticated local application session","success":200},

    {"method":"GET","path":"/api/v1/reference/dispatch-locations","handler":"ListActiveReferences(dispatch_location)","auth":"authenticated local application session","success":200},
    {"method":"POST","path":"/api/v1/reference/dispatch-locations","handler":"CreateStandaloneDispatchLocation","auth":"authenticated local application session + anti-forgery","success":201},
    {"method":"GET","path":"/api/v1/reference/dispatch-locations/{dispatch_location_id}","handler":"GetReferenceById","auth":"authenticated local application session","success":200},
    {"method":"PATCH","path":"/api/v1/reference/dispatch-locations/{dispatch_location_id}","handler":"UpdateReferenceDescriptiveData","auth":"authenticated local application session + anti-forgery","success":200},

    {"method":"POST","path":"/api/v1/reference/{reference_type}/{reference_id}/archive-preview","handler":"PreviewReferenceArchive","auth":"authenticated local application session","success":200},
    {"method":"POST","path":"/api/v1/reference/{reference_type}/{reference_id}/archive","handler":"ArchiveReference","auth":"authenticated local application session + anti-forgery","success":200},
    {"method":"POST","path":"/api/v1/reference/{reference_type}/{reference_id}/reactivate","handler":"ReactivateReference","auth":"authenticated local application session + anti-forgery","success":200},

    {"method":"POST","path":"/api/v1/reference/match/customer-organization","handler":"MatchCustomerOrganization","auth":"authenticated local application session","success":200},
    {"method":"POST","path":"/api/v1/reference/match/contact","handler":"MatchContact","auth":"authenticated local application session","success":200},

    {"method":"GET","path":"/api/v1/settings/{setting_key}","handler":"GetSetting","auth":"authenticated local application session","success":200},
    {"method":"PUT","path":"/api/v1/settings/{setting_key}","handler":"WriteSetting","auth":"authenticated local application session + anti-forgery","success":200}
  ],
  "route_rules":[
    "There is no DELETE route for Customer Organization, Contact, Dispatch Location, Contact channel, external-identifier history, affiliation history, or lifecycle evidence in LLD-02.",
    "All mutating requests carry command_id and base_revision/equivalent precondition where the target already exists.",
    "Customer Account Code reassignment/shared-claim acceptance is reasoned reviewed correction and cannot be encoded as an ordinary Customer PATCH.",
    "Match, channel-use validation and archive-preview routes are pure queries and never create/link/merge/assign external identifiers.",
    "All cursor/limit inputs use bounds.json defaults/maxima and opaque server cursors; omitted continuation data cannot change AMBIGUOUS or archive eligibility state.",
    "Generic reference_type is resolved through the closed enum customer_organization|contact|dispatch_location before application dispatch and is never used to construct SQL/table identifiers.",
    "Archived records are retrieved by immutable ID/history routes but ordinary active-list selectors exclude them.",
    "CreateDedicatedDispatchLocationForSite is an internal cross-domain application-service interface used by LLD-08, not a public HTTP route.",
    "Local User Profile identity creation is first-run LLD-12 coordination and is not exposed as ordinary reference CRUD.",
    "LLD-01 stable errors plus errors.json domain codes are the only machine-readable failure surface; LLD-10 owns presentation."
  ]
}
