{
  "schema":"SOMA-LLD-ROUTE-FRAGMENT-V1",
  "lld_id":"LLD-04",
  "family":"wfm_competing_attempt_review_route",
  "routes":[
    {
      "method":"POST",
      "path":"/api/v1/imports/proposals/{proposal_id}/wfm-competing-attempt-review",
      "handler_kind":"command",
      "handler":"ResolveWfmCompetingAttemptReview",
      "request_type":"ResolveWfmCompetingAttemptReviewRequestV1",
      "response_type":"ProposalDecisionResultV1",
      "success_status":200,
      "max_request_bytes":8192,
      "auth_policy":"LLD12_BROWSER_MUTATION_V1",
      "error_codes":["IMPORT_PROPOSAL_NOT_FOUND","IMPORT_PROPOSAL_STALE","IMPORT_PROPOSAL_BLOCKED","IMPORT_RECOVERY_AUTHORIZATION_REQUIRED","IMPORT_RECOVERY_REVIEW_STALE","TASK_NOT_FOUND","TASK_STALE","TASK_ACTIVITY_LINEAGE_CONFLICT","TASK_ACTIVITY_REVIEW_STALE","IDEMPOTENCY_CONFLICT"]
    }
  ],
  "rule":"This route is the only public accept path for proposal_kind=wfm_competing_attempt_review. Generic /accept remains blocked for that kind. The request supplies an explicit LLD-05 activity-lineage decision and exact preview fingerprint; overlap/conflict evidence never selects the decision."
}
