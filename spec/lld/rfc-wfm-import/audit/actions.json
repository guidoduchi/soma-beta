{"schema":"SOMA-LLD-AUDIT-REGISTRY-V2","lld_id":"LLD-04","actions":[{"action_type":"ticket_import.check_started","action_version":1,"payload_schema":"ImportCheckStartedAuditV1","payload_version":1,"target_policy":"import source family","result_refs":"job_id only","sensitivity":"metadata_only_no_selected_path"},{"action_type":"ticket_import.run_published","action_version":1,"payload_schema":"ImportRunPublishedAuditV1","payload_version":1,"target_policy":"import_run_id","result_refs":"run revision + state","sensitivity":"candidate filename/profile IDs/counts/fingerprint allowed; no raw row/workbook path"},{"action_type":"ticket_import.proposal_decided","action_version":1,"payload_schema":"ImportProposalDecisionAuditV1","payload_version":1,"target_policy":"reconciliation_proposal_id","result_refs":"proposal revision + owning-domain immutable refs","sensitivity":"bounded identities/reason category only; no unrestricted source text"},{"action_type":"ticket_import.run_finalized","action_version":1,"payload_schema":"ImportRunFinalizedAuditV1","payload_version":1,"target_policy":"import_run_id","result_refs":"terminal run revision + checkpoint","sensitivity":"metadata_only"},{"action_type":"ticket_import.checkpoint_advanced","action_version":1,"payload_schema":"ImportCheckpointAuditV1","payload_version":1,"target_policy":"source family","result_refs":"checkpoint revision/import_run_id","sensitivity":"fingerprint/chronology metadata only"},{"action_type":"ticket_import.recovery_reviewed","action_version":1,"payload_schema":"ImportRecoveryAuditV1","payload_version":1,"target_policy":"import_run_id","result_refs":"review ordinal + decision","sensitivity":"metadata_only"}],"payload_types":{"ImportCheckStartedAuditV1":{"fields":["source_family","invocation_kind","job_id"]},"ImportRunPublishedAuditV1":{"fields":["import_run_id","source_family","run_state","profile_ids","candidate_filename","candidate_chronology_kind","candidate_chronology_value","logical_fingerprint","counts","revision"]},"ImportProposalDecisionAuditV1":{"fields":["proposal_id","proposal_kind","decision","proposal_revision","reason_category","owner_result_refs"]},"ImportRunFinalizedAuditV1":{"fields":["import_run_id","final_state","revision","checkpoint_revision","accepted_count","rejected_count","deferred_count"]},"ImportCheckpointAuditV1":{"fields":["source_family","import_run_id","chronology_kind","chronology_value","logical_fingerprint","checkpoint_revision"]},"ImportRecoveryAuditV1":{"fields":["import_run_id","review_ordinal","decision","reason_category","review_fingerprint"]}},"rules":["All actions are appended by LLD-01 AuditWriter inside the authoritative caller UnitOfWork.","Audit payload construction uses closed typed fields and never serializes workbook rows, cell contents, formulas, absolute selected paths, stack traces, credentials or arbitrary exception text.","Owning-domain audit entries remain owned by LLD-02/03/05/06; LLD-04 records proposal disposition/orchestration and references their immutable result IDs rather than duplicating domain facts."]}