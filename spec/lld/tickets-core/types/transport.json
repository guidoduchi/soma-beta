{
  "schema":"SOMA-LLD-TYPES-V2",
  "lld_id":"LLD-03",
  "family":"ticket_core_transport",
  "delegated_type_files":["types/sr-reference-transport.json","types/rfc-lifecycle-transport.json"],
  "types":{
    "CreateManualServiceRequestRequestV1":{"kind":"command_payload","body_fields":{"official_sr_no":"SR-8|null"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject","rule":"Customer/reference/source/descriptive facts are changed only by their owning commands or accepted reconciliation; manual identity creation does not smuggle those mutations into this DTO."},
    "ServiceRequestIdQueryV1":{"kind":"transport_query","path_fields":["service_request_id:uuid"],"query_fields":{},"unknown_fields":"reject"},
    "AttachOfficialServiceRequestIdentityRequestV1":{"kind":"command_payload","path_fields":["service_request_id:uuid"],"body_fields":{"base_revision":"int>=1","official_sr_no":"SR-8","review_context":"bounded reviewed identity-adoption evidence"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "CreateOrAdoptRfcIdentityRequestV1":{"kind":"command_payload","body_fields":{"rfc_no":"NC + 14 digits","creation_context":"manual|provisional|accepted_source_adoption","customer_org_id":"uuid|null"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject","rule":"Source-owned RFC descriptive/status fields are not accepted through identity creation; accepted source projection remains a separate governed reconciliation mutation."},
    "RfcIdQueryV1":{"kind":"transport_query","path_fields":["rfc_id:uuid"],"query_fields":{},"unknown_fields":"reject"},
    "SetRfcCustomerRequestV1":{"kind":"command_payload","path_fields":["rfc_id:uuid"],"body_fields":{"base_revision":"int>=1","customer_org_id":"uuid|null","reason_category":"bounded string","review_fingerprint":"sha256 hex|null"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "AddRfcSubordinateRequestV1":{"kind":"command_payload","path_fields":["parent_rfc_id:uuid"],"body_fields":{"child_rfc_id":"uuid","base_revisions":"bounded closed map<rfc_id,int>=1>","review_fingerprint":"sha256 hex|null","reason_category":"bounded string"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject","rule":"child_rfc_id is the exact existing RFC identity proposed as subordinate; hierarchy authority is never inferred from RFC numbering, source adjacency or client role labels."},
    "ReparentRfcRequestV1":{"kind":"command_payload","path_fields":["child_rfc_id:uuid"],"body_fields":{"new_parent_rfc_id":"uuid","base_revisions":"bounded closed map<rfc_id,int>=1>","review_fingerprint":"SOMA_RFC_HIERARCHY_REVIEW_V1 sha256 hex|null","reason_category":"bounded string"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject","rule":"new_parent_rfc_id is explicit mutation input; current old parent is resolved/revalidated authoritatively. HIGH history risk requires the exact current review_fingerprint. LOW permits null, but any supplied review_fingerprint must still equal the current preview authority; a history/provider fingerprint change stales the review even when hierarchy and LOW/HIGH classification are unchanged."},
    "DetachRfcRequestV1":{"kind":"command_payload","path_fields":["child_rfc_id:uuid"],"body_fields":{"base_revisions":"bounded closed map<rfc_id,int>=1>","review_fingerprint":"SOMA_RFC_HIERARCHY_REVIEW_V1 sha256 hex|null","reason_category":"bounded string"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject","rule":"child_rfc_id comes from the path and its current parent/edge is resolved/revalidated authoritatively. HIGH history risk requires the exact current review_fingerprint. LOW permits null, but a supplied fingerprint must be current."},
    "RfcHierarchyPreviewQueryV1":{"kind":"transport_query","body_fields":{"action":"reparent|detach","child_rfc_id":"uuid","new_parent_rfc_id":"uuid|null; required for reparent and null for detach"},"unknown_fields":"reject","rule":"preview resolves old parent/current revisions and never trusts client role, old-edge or history-risk state"},
    "RfcHierarchyHistoryAuthorityV1":{"kind":"internal_cross_packet_object","required":["status","risk","evidence_exact_count","provider_fingerprint","warning_code"],"fields":{"status":"READY|INDETERMINATE","risk":"LOW|HIGH|null","evidence_exact_count":"int>=0|null","provider_fingerprint":"SOMA_RFC_HIERARCHY_HISTORY_AUTHORITY_V1 lowercase sha256 hex|null","warning_code":"bounded stable code|null"},"unknown_fields":"reject","rules":["READY requires risk LOW|HIGH, non-null evidence_exact_count/provider_fingerprint and null warning_code","INDETERMINATE requires risk/evidence_exact_count/provider_fingerprint null and non-null warning_code","provider_fingerprint binds the complete current LLD-05 risk-evidence authority, not merely the LOW/HIGH classification"]},
    "RfcHierarchyMutationPreviewV1":{"kind":"object","required":["action","child_rfc_id","old_parent_rfc_id","new_parent_rfc_id","old_edge_id","base_revisions","old_branch_fingerprint","new_branch_fingerprint","history_authority","blockers","warnings","review_required","review_fingerprint"],"fields":{"action":"reparent|detach","child_rfc_id":"uuid","old_parent_rfc_id":"uuid","new_parent_rfc_id":"uuid|null","old_edge_id":"uuid","base_revisions":"bounded closed map<rfc_id,int>=1 for exactly the command participants","old_branch_fingerprint":"SOMA_RFC_BRANCH_FINGERPRINT_V1 lowercase sha256 hex","new_branch_fingerprint":"SOMA_RFC_BRANCH_FINGERPRINT_V1 lowercase sha256 hex|null","history_authority":"RfcHierarchyHistoryAuthorityV1","blockers":"bounded ordered array<stable blocker code>","warnings":"bounded ordered array<stable warning code>","review_required":"bool","review_fingerprint":"SOMA_RFC_HIERARCHY_REVIEW_V1 lowercase sha256 hex|null"},"unknown_fields":"reject","rules":["review_fingerprint is non-null only when history_authority.status=READY and is computed over the complete canonical hierarchy review authority","review_required is true exactly when READY history risk is HIGH","INDETERMINATE yields review_fingerprint null and cannot authorize mutation","preview is read-only and advisory; writer rebuilds the same authority in its UnitOfWork"]},
    "RfcBranchQueryV1":{"kind":"transport_query","path_fields":["root_rfc_id:uuid"],"query_fields":{"cursor":"CursorV1|null","limit":"int 1..500 default 100"},"unknown_fields":"reject"},
    "LinkServiceRequestRfcRequestV1":{"kind":"command_payload","path_fields":["service_request_id:uuid"],"body_fields":{"rfc_id":"uuid","sr_base_revision":"int>=1","rfc_base_revision":"int>=1","subordinate_origin_rfc_id":"uuid|null","review_fingerprint":"sha256 hex|null"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "UnlinkServiceRequestRfcRequestV1":{"kind":"command_payload","path_fields":["service_request_id:uuid","root_rfc_id:uuid"],"body_fields":{"sr_base_revision":"int>=1","rfc_base_revision":"int>=1","reason_category":"bounded string"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "CreateDeviceReferenceRequestV1":{"kind":"command_payload","body_fields":{"operational_name":"bounded string"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "CorrectDeviceReferenceNameRequestV1":{"kind":"command_payload","path_fields":["device_reference_id:uuid"],"body_fields":{"base_revision":"int>=1","operational_name":"bounded string","reason_category":"bounded string"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "TicketDeviceReferenceMutationRequestV1":{"kind":"command_payload","path_fields":["ticket_type:service_request|rfc","ticket_id:uuid","device_reference_id:uuid"],"body_fields":{"target_base_revision":"int>=1","reason_category":"bounded string|null"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "WorkingNoteListQueryV1":{"kind":"transport_query","path_fields":["ticket_type:service_request|rfc","ticket_id:uuid"],"query_fields":{"cursor":"CursorV1|null","limit":"int 1..500 default 100"},"unknown_fields":"reject"},
    "AddWorkingNoteRequestV1":{"kind":"command_payload","path_fields":["ticket_type:service_request|rfc","ticket_id:uuid"],"body_fields":{"body_text":"bounded string"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "EditWorkingNoteRequestV1":{"kind":"command_payload","path_fields":["ticket_type:service_request|rfc","ticket_id:uuid","working_note_id:uuid"],"body_fields":{"base_revision":"int>=1","body_text":"bounded string"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "RemoveWorkingNoteRequestV1":{"kind":"command_payload","path_fields":["ticket_type:service_request|rfc","ticket_id:uuid","working_note_id:uuid"],"body_fields":{"base_revision":"int>=1","reason_category":"bounded string|null"},"command_envelope":"COMMAND_ENVELOPE_V1","unknown_fields":"reject"},
    "ServiceRequestDetailV1":{"kind":"object","required":["service_request_id","identity","revision","source_projection","reference_context","linked_root_rfc_count","device_reference_count","warnings"],"fields":{"service_request_id":"uuid","identity":"closed SR identity projection","revision":"int>=1","source_projection":"accepted current projection with opaque immutable LLD-04 evidence refs|null","reference_context":"ServiceRequestReferenceContextV1","linked_root_rfc_count":"int>=0","device_reference_count":"int>=0","warnings":"bounded array<string>"}},
    "TicketMutationResultV1":{"kind":"object","required":["outcome","target_id","revision"],"fields":{"outcome":"APPLIED|NO_CHANGE","target_id":"uuid","revision":"int>=1","result_refs":"bounded array<typed ref>"}},
    "RfcDetailV1":{"kind":"object","required":["rfc_id","rfc_no","revision","hierarchy_role","customer_org_id","local_archive_state","source_projection","direct_service_request_count","device_reference_count","subordinate_count","warnings"],"fields":{"rfc_id":"uuid","rfc_no":"NC + 14 digits","revision":"int>=1","hierarchy_role":"standalone|root|subordinate","customer_org_id":"uuid|null","local_archive_state":"active|archived","source_projection":"accepted current projection|null","direct_service_request_count":"int>=0","device_reference_count":"int>=0","subordinate_count":"int>=0","warnings":"bounded array<string>"}},
    "RfcBranchV1":{"kind":"object","required":["root","subordinates","continuation","branch_fingerprint"],"fields":{"root":"RfcDetailV1","subordinates":"bounded array<RfcDetailV1> ordered by rfc_id ASC","continuation":"CursorV1|null using spec/lld/tickets-core/algorithms/rfc-hierarchy.json#branch_cursor","branch_fingerprint":"SOMA_RFC_BRANCH_FINGERPRINT_V1 lowercase sha256 hex using spec/lld/tickets-core/algorithms/rfc-hierarchy.json#branch_fingerprint"},"rule":"branch_fingerprint covers the complete structural branch independent of the returned page; mutation responses use the exact post-command response-root and default 100-child first-page rule from rfc-hierarchy.json"},
    "DeviceReferenceV1":{"kind":"object","required":["device_reference_id","operational_name","revision"],"fields":{"device_reference_id":"uuid","operational_name":"string","revision":"int>=1","registered_network_element_id":"uuid|null derived read-only from LLD-08"}},
    "WorkingNoteV1":{"kind":"object","required":["working_note_id","body_text","revision","created_at_utc","updated_at_utc","created_by_local_user_profile_id"],"fields":{"working_note_id":"uuid","body_text":"bounded string","revision":"int>=1","created_at_utc":"UTC epoch whole-second int>=0","updated_at_utc":"UTC epoch whole-second int>=created_at_utc","created_by_local_user_profile_id":"uuid"}},
    "WorkingNotePageV1":{"kind":"object","required":["items","continuation"],"fields":{"items":"bounded array<WorkingNoteV1>","continuation":"CursorV1|null"}},
    "CursorV1":{"kind":"reference","contract":"spec/lld/_packet-contract-v2.json#cursor_contract"}
  }
}
