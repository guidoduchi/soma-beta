    "RfcLifecycleProjectionV1":{"kind":"object","required":["rfc_id","accepted_source_state","local_archive_state","terminal_epoch_id"],"fields":{"rfc_id":"uuid","accepted_source_state":"closed accepted source projection","local_archive_state":"active|archived","terminal_epoch_id":"opaque id|null"}},
    "RfcArchivePreviewV1":{"kind":"object","required":["scope_kind","exact_member_count","would_change_count","excluded_prearchived_count","items","continuation","scope_fingerprint"],"fields":{"scope_kind":"exact_rfc|reviewed_branch","exact_member_count":"int>=0","would_change_count":"int>=0","excluded_prearchived_count":"int>=0","items":"bounded ordered array<rfc_id,revision,archive_state,change_classification>","continuation":"CursorV1|null","scope_fingerprint":"sha256 hex computed over the complete current scope and revisions"},"rule":"Transport paging never weakens scope authority: the command recomputes the complete server-side fingerprint under the writer lock."},
