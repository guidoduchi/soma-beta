    {"method":"POST","path":"/api/v1/inventory/needs/{need_id}/local-selection","handler_kind":"command","handler":"RecordLocalNeedFulfillmentSelection","request_type":"RecordLocalNeedFulfillmentSelectionRequestV1","response_type":"InventoryMutationResultV1","success_status":200,"max_request_bytes":8192,"auth_policy":"LLD12_BROWSER_MUTATION_V1","error_codes":["INV_STALE","STOCK_NOT_ELIGIBLE","IDEMPOTENCY_CONFLICT"]},
