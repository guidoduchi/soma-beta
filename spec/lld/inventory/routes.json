    {"method":"POST","path":"/api/v1/inventory/needs/{need_id}/plan","handler_kind":"command","handler":"SetSpareNeedPlannedQuantity","request_type":"SetSpareNeedPlannedQuantityRequestV1","response_type":"InventoryMutationResultV1","success_status":200,"max_request_bytes":4096,"auth_policy":"LLD12_BROWSER_MUTATION_V1","error_codes":["INV_STALE","NEED_CROSS_SR","IDEMPOTENCY_CONFLICT"]},
    {"method":"POST","path":"/api/v1/inventory/needs/{need_id}/lifecycle","handler_kind":"command","handler":"ChangeSpareNeedLifecycle","request_type":"ChangeSpareNeedLifecycleRequestV1","response_type":"InventoryMutationResultV1","success_status":200,"max_request_bytes":4096,"auth_policy":"LLD12_BROWSER_MUTATION_V1","error_codes":["INV_STALE","NEED_DELETE_BLOCKED","DEPENDENCY_INDETERMINATE","IDEMPOTENCY_CONFLICT"]},
    {"method":"POST","path":"/api/v1/inventory/units","handler_kind":"command","handler":"RegisterSparePartUnit","request_type":"RegisterSparePartUnitRequestV1","response_type":"InventoryMutationResultV1","success_status":201,"max_request_bytes":8192,"auth_policy":"LLD12_BROWSER_MUTATION_V1","error_codes":["INV_INVALID_ID","STOCK_NOT_ELIGIBLE","IDEMPOTENCY_CONFLICT"]},
