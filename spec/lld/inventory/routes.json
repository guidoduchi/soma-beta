    {"method":"POST","path":"/api/v1/inventory/logistics/participants/{participant_id}/correct","handler_kind":"command","handler":"CorrectLogisticsParticipant","request_type":"CorrectLogisticsParticipantRequestV1","response_type":"InventoryMutationResultV1","success_status":200,"max_request_bytes":8192,"auth_policy":"LLD12_BROWSER_MUTATION_V1","error_codes":["INV_STALE","CORRECTION_TARGET_INVALID","IDEMPOTENCY_CONFLICT"]}
  ],
  "route_rules":["All routes are loopback-only under LLD-01 runtime and use LLD-12 authenticated browser policy; authoritative mutations use anti-forgery and COMMAND_ENVELOPE_V1.","GET and explicit preview routes are side-effect-free and never reserve stock, create physical units, accept warehouse decisions or alter Task state.","Physical Spare Part Unit creation from an RMA occurs only on accepted actual inbound receipt; RMA authorization alone never creates a physical unit.","Inventory consumes reviewed Task evidence through LLD-05 and records separate physical consequences; it never writes Task execution, outcome, cancellation, retry or Objective lifecycle.","Communication-derived evidence remains proposal-only until the exact Inventory proposal is deliberately accepted under current-state revalidation."]
}
