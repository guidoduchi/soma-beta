{
  "schema": "SOMA-LLD-TYPES-V2",
  "lld_id": "LLD-01",
  "types": {
    "RuntimeHealthQueryV1": {
      "kind": "object",
      "additionalProperties": false,
      "fields": {}
    },
    "RuntimeHealthV1": {
      "kind": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "run_id", "data_instance_id", "host_state", "app_version", "migration_sequence", "migration_id", "integrity_state", "started_at_utc"],
      "fields": {
        "protocol_version": "string",
        "run_id": "uuid",
        "data_instance_id": "uuid",
        "host_state": "LISTENING_NOT_READY|READY|QUIESCING",
        "app_version": "string",
        "migration_sequence": "int>=0",
        "migration_id": "string|null",
        "integrity_state": "string",
        "started_at_utc": "utc_epoch_seconds"
      }
    },
    "ShutdownHostRequestV1": {
      "kind": "object",
      "additionalProperties": false,
      "required": ["run_id", "data_instance_id", "command_id"],
      "fields": {
        "run_id": "uuid",
        "data_instance_id": "uuid",
        "command_id": "uuid"
      }
    },
    "ShutdownHostAcceptedV1": {
      "kind": "object",
      "additionalProperties": false,
      "required": ["shutdown_state", "run_id", "data_instance_id"],
      "fields": {
        "shutdown_state": "QUIESCING|ALREADY_QUIESCING",
        "run_id": "uuid",
        "data_instance_id": "uuid"
      }
    },
    "FoundationDiagnosticsQueryV1": {
      "kind": "object",
      "additionalProperties": false,
      "fields": {}
    },
    "FoundationDiagnosticsStateV1": {
      "kind": "object",
      "additionalProperties": false,
      "required": ["request_executor_depth", "background_executor_depth", "open_authoritative_connections", "active_transactions", "durable_jobs_by_state", "last_completed_migration", "recent_error_codes"],
      "fields": {
        "request_executor_depth": "EMPTY|LOW|ELEVATED|SATURATED",
        "background_executor_depth": "EMPTY|LOW|ELEVATED|SATURATED",
        "open_authoritative_connections": "int>=0",
        "active_transactions": "int>=0",
        "durable_jobs_by_state": "closed string->int map",
        "last_completed_migration": "MigrationIdentityV1|null",
        "recent_error_codes": "array<string> max 32"
      }
    },
    "MigrationStatusQueryV1": {
      "kind": "object",
      "additionalProperties": false,
      "fields": {}
    },
    "MigrationStatusV1": {
      "kind": "object",
      "additionalProperties": false,
      "required": ["state", "current_sequence", "current_migration_id", "target_sequence", "integrity_state"],
      "fields": {
        "state": "NOT_INITIALIZED|CURRENT|MIGRATIONS_PENDING|DRIFT|LEDGER_MISMATCH|UNSUPPORTED_FUTURE_VERSION|INVALID_DATABASE|INSTANCE_LAYOUT_INVALID|INTEGRITY_FAILURE|LIVE_CURRENT|LIVE_MIGRATIONS_PENDING|LIVE_LIMITED|LOCKED_UNVERIFIED|OFFLINE_SIDECAR_STATE_UNSAFE|INSPECTION_FAILURE",
        "current_sequence": "int>=0|null",
        "current_migration_id": "string|null",
        "target_sequence": "int>=0",
        "integrity_state": "string|null"
      }
    },
    "MigrationIdentityV1": {
      "kind": "object",
      "additionalProperties": false,
      "required": ["sequence", "migration_id"],
      "fields": {
        "sequence": "int>=1",
        "migration_id": "string"
      }
    },
    "CommittedCommandResultV1": {
      "kind": "internal_persisted_value",
      "additionalProperties": false,
      "required": ["command_id", "response_schema", "response_version", "response_json", "response_sha256"],
      "fields": {
        "command_id": "uuid",
        "response_schema": "nonempty bounded string",
        "response_version": "int>=1",
        "response_json": "strict canonical JSON text <= foundation command_replay.max_response_json_bytes",
        "response_sha256": "lowercase sha256 hex"
      },
      "rules": [
        "response_json represents the exact owning-command result returned by the original successful commit, including exact NO_CHANGE result",
        "hash is calculated over exact UTF-8 bytes of canonical response_json",
        "value is immutable after insertion and is never reconstructed from mutable current domain state"
      ]
    },
    "DurableJobClaimV1": {
      "kind": "internal_value",
      "additionalProperties": false,
      "required": ["job_id", "job_type", "contract_version", "run_id", "attempt_ordinal", "claim_started_at_utc", "dedupe_sha256", "payload_json", "checkpoint_json"],
      "fields": {
        "job_id": "uuid",
        "job_type": "registered nonempty bounded string",
        "contract_version": "int>=1",
        "run_id": "uuid",
        "attempt_ordinal": "int>=1",
        "claim_started_at_utc": "utc_epoch_seconds",
        "dedupe_sha256": "lowercase sha256 hex",
        "payload_json": "exact strict canonical registered packet payload JSON <= foundation jobs.max_payload_json_bytes",
        "checkpoint_json": "exact strict canonical registered packet checkpoint JSON|null <= foundation jobs.max_checkpoint_json_bytes"
      },
      "rules": [
        "job_id + run_id + attempt_ordinal + claim_started_at_utc is the complete persisted claim token revalidated by checkpoint/complete/fail; matching only job_id/run_id is insufficient",
        "payload/checkpoint are validated against the exact registered job_type + contract_version before the claim is returned",
        "the claim is an in-process technical capability only and is never persisted outside the existing durable job tables or exposed as domain authority"
      ]
    },
    "DurableJobRecoverySummaryV1": {
      "kind": "internal_value",
      "additionalProperties": false,
      "required": ["examined_count", "interrupted_count", "queued_count", "retry_wait_count", "waiting_review_count", "failed_count", "skipped_count"],
      "fields": {
        "examined_count": "int>=0",
        "interrupted_count": "int>=0",
        "queued_count": "int>=0",
        "retry_wait_count": "int>=0",
        "waiting_review_count": "int>=0",
        "failed_count": "int>=0",
        "skipped_count": "int>=0"
      },
      "rule": "counts are technical recovery evidence only; they never imply owning-domain completion or lifecycle state"
    },
    "RestoreJobReconciliationV1": {
      "kind": "internal_value",
      "additionalProperties": false,
      "required": ["examined_nonterminal_count", "cancelled_count", "interrupted_attempt_count", "unchanged_terminal_count"],
      "fields": {
        "examined_nonterminal_count": "int>=0",
        "cancelled_count": "int>=0",
        "interrupted_attempt_count": "int>=0",
        "unchanged_terminal_count": "int>=0"
      },
      "rule": "returned only from the restore-finalization boundary before READY; it records technical invalidation of restored work and never reverses/fabricates domain history"
    },
    "DurableJobCancellationResultV1": {
      "kind": "object",
      "additionalProperties": false,
      "required": ["outcome", "job_id", "prior_state", "resulting_state", "claim_revoked"],
      "fields": {
        "outcome": "CANCELLED|ALREADY_CANCELLED|TERMINAL_UNCHANGED",
        "job_id": "uuid",
        "prior_state": "queued|running|waiting_review|retry_wait|completed|failed|cancelled",
        "resulting_state": "cancelled|completed|failed",
        "claim_revoked": "boolean",
        "cancelled_attempt_ordinal": "int>=1|null"
      },
      "rules": [
        "CANCELLED is returned only when this call atomically changes a nonterminal durable job to cancelled.",
        "ALREADY_CANCELLED performs no second mutation.",
        "TERMINAL_UNCHANGED reports completed or failed without rewriting that terminal technical history; the owning-domain caller decides whether its own domain transition remains valid.",
        "claim_revoked=true only when a running claim was atomically invalidated; correctness never depends on an in-memory cancellation signal."
      ]
    },
    "OverviewReadSnapshotV1": {
      "kind": "opaque_context",
      "rule": "Foundation-owned read snapshot/connection handle valid only inside context manager; never serialized or persisted."
    },
    "DatabaseConnectionV1": {
      "kind": "opaque_context",
      "rule": "SQLCipher DB-API compatible connection already keyed and safety-verified; never crosses transport or persists as data."
    },
    "CommandEnvelopeV1": {
      "kind": "reference",
      "contract": "spec/lld/_packet-contract-v2.json#command_envelope"
    },
    "CursorV1": {
      "kind": "reference",
      "contract": "spec/lld/_packet-contract-v2.json#cursor_contract"
    }
  }
}
