{"schema":"SOMA-LLD-INTERFACE-REGISTRY-V2","lld_id":"LLD-05","authority":"canonical_cross_packet_callable_contract","provided":[{"name":"WfmImportReader","methods":["get_by_task_no(reader,task_no)","source_projection(reader,task_id)","source_plan(reader,task_id)","operational_plan_context(reader,task_id)","activity_conflicts(reader,task_id_or_candidate,interval) -> ConflictSet","source_acceptance_base_token(reader,target) -> sha256"],"transaction":"read-only"},{"name":"WfmImportMutationService","methods":["create_or_adopt_wfm_from_source(uow,proposal,command_context)","apply_wfm_source_projection(uow,proposal,command_context)","apply_reviewed_operational_plan_from_source(uow,proposal,command_context)"],"transaction":"caller UnitOfWork; no nested receipt/commit"},{"name":"RfcTerminalTaskParticipant","methods":["capture_applicable_wfms(uow,rfc_ids) -> ordered immutable task identities/revisions/task_nos","preview_terminal_cascade(snapshot,proposal_snapshot) -> TaskObjectiveImpact|INDETERMINATE","revalidate_terminal_cascade(uow,proposal_snapshot,reviewed_exact_count,reviewed_provider_fingerprint) -> READY|STALE|INDETERMINATE","apply_terminal_cascade(uow,proposal_snapshot) -> immutable result refs","classify_hard_delete_dependency(uow,rfc_id) -> CLEAR|BLOCKED|INDETERMINATE"],"rule":"Preview owns the complete Task/Objective impact calculation and provider fingerprint. Revalidate uses the caller LLD-03 writer UnitOfWork, recomputes that same complete current impact authority, exact-compares reviewed count/fingerprint, returns no impact rows and mutates nothing. Apply uses the same caller UnitOfWork only after LLD-03 has both provider revalidations READY and never commits independently."},{"name":"RfcHistoryRiskProvider","methods":["classify_reparent_risk(uow,rfc_id) -> LOW|HIGH|INDETERMINATE"]},{"name":"TaskOperationalEvidenceReader","methods":["task_outcome(snapshot,task_id)","task_execution(snapshot,task_id)","objective_context(snapshot,task_id)","review_fingerprint(snapshot,task_id)"],"transaction":"read-only"},{"name":"TaskSiteDependencyValidator","methods":["guard_archive(uow,site_id) -> CLEAR|BLOCKED|INDETERMINATE","count_blockers(snapshot,site_id) -> int","list_blockers(snapshot,site_id,cursor,limit) -> page"],"rule":"Read-only validation; authoritative guard uses caller UnitOfWork and fails closed."},{"name":"ObjectiveOverviewProjectionProvider","methods":["project_overview(snapshot,OverviewWindowV1,CustomerScopeResolutionV1) -> ObjectiveOverviewProjectionV1","iter_communication_targets(snapshot,OverviewWindowV1,CustomerScopeResolutionV1) -> ordered iterator[CommunicationTargetRefV1]"],"transaction":"read-only; uses caller Overview snapshot"},{"name":"TaskObjectiveCommunicationIdentityProvider","methods":["snapshot_trackable_wfm_objective(reader) -> iterator[TrackableIdentityV1]","validate_trackable_target(uow,target_type,target_id,target_revision,matched_identity) -> VALID|INVALID|INDETERMINATE"],"rule":"Read/validation only; no Communication writer."}],"consumed":[{"name":"InventoryTaskDependencyProvider","provider":"LLD-07","methods":["classify_task_hard_delete_dependency(uow,task_id) -> CLEAR|BLOCKED|INDETERMINATE","preview_retry_relationship_clone(snapshot,predecessor_task_id,selected_inventory_relationship_ids) -> Impact","apply_retry_relationship_clone(uow,preview,new_task_id) -> result refs"]}],"rules":["Task lifecycle remains LLD-05 authority; cross-domain consumers cannot infer execution from plans or provider source state.","Objective state remains derived from Task facts; starting an Objective never creates Task execution evidence by itself.","RFC terminal-cascade writer revalidation and apply share the caller LLD-03 UnitOfWork; neither creates a receipt, commit or rollback, and revalidation must precede deliberate-proof consumption and apply."]}