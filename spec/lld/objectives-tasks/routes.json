{
  "schema":"SOMA-LLD-ROUTES-V1",
  "lld_id":"LLD-05",
  "base":"/api",
  "routes":[
    {"method":"GET","path":"/tasks","purpose":"paged Task list/filter projection"},
    {"method":"GET","path":"/tasks/{task_id}","purpose":"Task identity, current plan, execution, outcome, membership and derived context"},
    {"method":"POST","path":"/tasks/local","command":"CreateLocalTask"},
    {"method":"POST","path":"/tasks/wfm/manual","command":"RegisterManualWfmTask"},
    {"method":"POST","path":"/tasks/wfm/{task_id}/parent","command":"ReassignWfmParent"},
    {"method":"POST","path":"/tasks/{task_id}/plan","command":"SetTaskPlan"},
    {"method":"POST","path":"/tasks/{task_id}/plan/correct","command":"CorrectTaskPlan"},
    {"method":"POST","path":"/tasks/{task_id}/locks","command":"SetExplicitTaskLock"},
    {"method":"POST","path":"/tasks/{task_id}/relationships","command":"ChangeTaskRelationship"},
    {"method":"POST","path":"/tasks/wfm/activity-review","command":"ReviewWfmActivityRelationship"},
    {"method":"POST","path":"/tasks/{task_id}/execution/start","command":"StartTaskExecution"},
    {"method":"POST","path":"/tasks/{task_id}/execution/end","command":"EndTaskExecution"},
    {"method":"POST","path":"/tasks/{task_id}/execution/correct","command":"CorrectTaskExecutionEvidence"},
    {"method":"POST","path":"/tasks/{task_id}/cancel","command":"CancelTaskWithoutExecution"},
    {"method":"POST","path":"/tasks/{task_id}/review","command":"ReviewTaskOutcome"},
    {"method":"POST","path":"/tasks/{task_id}/review/correct","command":"CorrectTaskOutcome"},
    {"method":"POST","path":"/tasks/wfm/{task_id}/source-terminal-review","command":"ResolveWfmSourceTerminalConsequence"},
    {"method":"POST","path":"/tasks/{task_id}/retry/local","command":"CreateLocalTaskRetry"},
    {"method":"POST","path":"/tasks/{task_id}/retry/wfm-link","command":"LinkWfmRetryAttempt"},
    {"method":"POST","path":"/tasks/{task_id}/operational-counts","command":"SetHistoricalTaskOperationalCountInclusion"},
    {"method":"POST","path":"/tasks/{task_id}/hard-delete-preview","command":"PreviewTaskHardDelete"},
    {"method":"DELETE","path":"/tasks/{task_id}","command":"HardDeleteTask"},
    {"method":"GET","path":"/objectives","purpose":"paged Objective list/filter with derived envelope/aggregate/ordinal"},
    {"method":"GET","path":"/objectives/{objective_id}","purpose":"Objective workbench projection"},
    {"method":"POST","path":"/objectives/create-preview","command":"PreviewObjectiveCreation"},
    {"method":"POST","path":"/objectives","command":"CreateObjectiveFromPreview"},
    {"method":"POST","path":"/objectives/{objective_id}/execution/start","command":"StartObjectiveExecution"},
    {"method":"POST","path":"/objectives/{objective_id}/cancel","command":"CancelObjectiveBeforeExecution"},
    {"method":"POST","path":"/objectives/{objective_id}/review","command":"ReviewObjective"},
    {"method":"POST","path":"/objectives/{objective_id}/archive","command":"ArchiveObjective"},
    {"method":"POST","path":"/objectives/{objective_id}/restore","command":"RestoreObjective"},
    {"method":"POST","path":"/objectives/{objective_id}/hard-delete-preview","command":"PreviewObjectiveHardDelete"},
    {"method":"DELETE","path":"/objectives/{objective_id}","command":"HardDeleteObjective"},
    {"method":"GET","path":"/grouping/proposals","purpose":"paged regroup proposal list/preview"},
    {"method":"POST","path":"/grouping/recompute","command":"RecomputeGroupingProposals"},
    {"method":"POST","path":"/grouping/proposals/{proposal_id}/accept","command":"AcceptRegroupProposal"},
    {"method":"POST","path":"/grouping/proposals/{proposal_id}/reject","command":"RejectRegroupProposal"},
    {"method":"POST","path":"/grouping/proposals/{proposal_id}/reconsider","command":"ReconsiderRegroupInputs"},
    {"method":"GET","path":"/objectives/historical-proposals","purpose":"paged provider-Complete historical structure proposals"},
    {"method":"POST","path":"/objectives/historical-proposals/{proposal_id}/accept","command":"AcceptHistoricalObjectiveProposal"},
    {"method":"POST","path":"/objectives/historical-proposals/{proposal_id}/reject","command":"RejectHistoricalObjectiveProposal"},
    {"method":"GET","path":"/settings/objective-timezone","purpose":"read typed Objective timezone setting/default"},
    {"method":"POST","path":"/settings/objective-timezone","command":"SetObjectiveTimezone"}
  ],
  "mutation_headers":["Idempotency-Key/command_id","base revision or exact proposal fingerprint where applicable","authenticated session context supplied by LLD-12 rather than actor IDs from body"],
  "routing_rule":"Routes are transport adapters only. They never calculate authoritative envelope/aggregate/outcome state from client payloads and never bypass command services. LLD-10 may compose multi-step preview/confirmation flows over these routes without owning domain mutation."
}
